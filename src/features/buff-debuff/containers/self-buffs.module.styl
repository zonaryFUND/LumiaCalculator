.list
    display: flex
    flex-direction: column
    align-items: stretch
    position: absolute
    background: var(--base)
    width: 95vw
    max-width: 480px
    max-height: 80vh
    margin: auto
    inset: 0
    border-radius: 16px
    overflow-y: auto
    overscroll-behavior-y: none
    box-shadow: 0 0 25px rgba(0,0,0,0.5)
    padding: 16px

    h1
        font-size: 1.4rem
        margin-bottom: 12px

    li
        padding: 8px
        cursor: pointer
        border-radius: 8px

.list:focus
    outline: 0

.add
    margin-top: 8px
