.mobiletab
    height: 100%

.pctab
    display: flex
    position: relative
    flex-direction: column
    height: 100%

.tab
    >header
        width: 100%
        background: var(--c4)
        color: white
        padding: 8px
        font-size: 10px
    
    h2
        font-size: 1.35rem   

    h3
        display: flex
        align-items: center
        gap: 4px
        font-size: 1.2rem
        margin-bottom: 2px

        // ヘルプアイコン（components/common/help-icon.tsx）等、ラベル直後に置きたい要素は
        // この間隔（gap）で隣接させる。ヒントテキストのspanだけmargin-left: autoで右端に押し出す
        // （旧justify-content: space-betweenは2要素前提だったため、3要素以上でも成立するこの形に変更）
        span
            margin-left: auto
            text-align: right
            font-size: 0.8rem

    .content
        overflow-y: scroll
        overscroll-behavior-y: none
        height: 100%
        flex-grow: 1