.page
    padding: 24px
    max-width: 100%

    h1
        margin: 0 0 4px

    > p
        margin: 0 0 16px
        color: var(--dg)

.pagination
    display: flex
    align-items: center
    gap: 12px
    padding: 12px 0
    flex-wrap: wrap

.grid
    display: grid
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr))
    gap: 16px
    margin: 16px 0

.card
    background: #111
    border-radius: 8px
    padding: 8px
    overflow: hidden

.label
    color: white
    font-weight: bold
    margin: 0 0 8px
    font-size: 14px
